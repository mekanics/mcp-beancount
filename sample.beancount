; sample.beancount — synthetic ledger for testing
; Currency: CHF primarily, some USD in investments
; Spans 2023-2026

option "title" "Alex Sample Ledger"
option "operating_currency" "CHF"

; ────────────────────────────────────────────
; Account declarations
; ────────────────────────────────────────────
2020-01-01 open Assets:Bank:Checking CHF
2020-01-01 open Assets:Bank:Savings CHF
2020-01-01 open Assets:Investments:IBKR USD
2020-01-01 open Liabilities:CreditCard CHF
2020-01-01 open Income:Salary CHF
2020-01-01 open Income:Freelance CHF
2020-01-01 open Expenses:Food CHF
2020-01-01 open Expenses:Transport CHF
2020-01-01 open Expenses:Rent CHF
2020-01-01 open Expenses:Health CHF
2020-01-01 open Expenses:Entertainment CHF
2020-01-01 open Expenses:Utilities CHF
2020-01-01 open Equity:Opening-Balances

; ────────────────────────────────────────────
; Opening balances (2020-01-01)
; ────────────────────────────────────────────
2020-01-01 * "Opening balance"
  Assets:Bank:Checking      15000 CHF
  Assets:Bank:Savings       30000 CHF
  Assets:Investments:IBKR    5000 USD
  Liabilities:CreditCard    -2000 CHF
  Equity:Opening-Balances

