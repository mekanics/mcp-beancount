# Required: absolute path to your Beancount ledger file
BEANCOUNT_FILE=/home/alex/finances/ledger.beancount

# Optional: comma-separated account prefix allowlist
# If set, all tools restrict results to matching accounts
# ACCOUNT_ALLOWLIST=Assets:Bank,Expenses:

# Optional: reload ledger on every request (for development/testing)
# BEANCOUNT_RELOAD=false
