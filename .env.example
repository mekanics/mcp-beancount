# .env.example — Copy to .env and fill in your values

# Required: absolute path to your Beancount ledger file
BEANCOUNT_FILE=/path/to/your/ledger.beancount

# Optional: override the base currency for net_worth_converted
# Defaults to the operating_currency directive in your ledger
# BASE_CURRENCY=CHF

# Optional: comma-separated account prefix allowlist
# When set, all tools are restricted to matching accounts only
# When unset, all accounts are accessible (default)
#
# Examples:
#   ACCOUNT_ALLOWLIST=Assets:Bank,Expenses:
#   ACCOUNT_ALLOWLIST=Assets:
#
# ACCOUNT_ALLOWLIST=

# Optional: reload ledger on every tool call (development mode only)
# BEANCOUNT_RELOAD=false

# Optional: log verbosity (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=WARNING
